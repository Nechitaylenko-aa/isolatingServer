{
    "name": "cpp-ai-refactor",
    "displayName": "C++ AI Refactor",
    "description": "AI-powered refactoring for C++ using local llama-server",
    "version": "0.0.1",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onLanguage:cpp"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "cpp-ai-refactor.refactor",
                "title": "AI Refactor: Analyze Current Method",
                "icon": "$(beaker)"
            }
        ],
        "keybindings": [
            {
                "command": "cpp-ai-refactor.refactor",
                "key": "ctrl+alt+r",
                "when": "editorLangId == cpp"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "cpp-ai-refactor.refactor",
                    "group": "navigation"
                }
            ],
            "commandPalette": [
                {
                    "command": "cpp-ai-refactor.refactor"
                }
            ]
        }
    },
    "scripts": {
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "@types/vscode": "^1.85.0",
        "typescript": "^5.0.0"
    }
}
