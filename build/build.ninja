  LINK_LIBRARIES = -Wl,-rpath,/usr/local/lib:/usr/local/llvm22/lib  libagent.a  libcore.a  /usr/local/lib/libCatch2Main.so.3.15.3  /usr/local/llvm22/lib/libclang.so  /usr/local/lib/libsqlite3.so  /usr/local/lib/libcurl.so  /usr/local/lib/libCatch2.so.3.15.3
  OBJECT_DIR = CMakeFiles/agent_tests.dir
